{
  "name": "template",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest --config jest.config.js",
    "android:dev": "react-native run-android --mode=developmentdebug --appId com.mindbowser.meetingroomkiosk.development",
    "android:dev-release": "react-native run-android --mode=developmentrelease --appId com.mindbowser.meetingroomkiosk.development",
    "android:prod": "react-native run-android --mode=productiondebug --appId com.mindbowser.meetingroomkiosk",
    "android:prod-release": "react-native run-android --mode=productionrelease --appId com.mindbowser.meetingroomkiosk",
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json}\"",
    "prepare": "husky install",
    "version-major": "node auto-versioning.js major",
    "version-minor": "node auto-versioning.js minor",
    "version-patch": "node auto-versioning.js patch",
    "generateMVCScreen": "cross-env CURRENT_DIR=$INIT_CWD node ./scripts/generateMVCScreen.ts",
    "generateReduxSlice": "cross-env CURRENT_DIR=$INIT_CWD node ./scripts/generateReduxSlice.ts",
    "generateRNComponent": "cross-env CURRENT_DIR=$INIT_CWD node ./scripts/generateRNComponent.ts",
    "ios:run:template:debug": "npx react-native run-ios --scheme template --mode Debug",
    "ios:run:template:release": "npx react-native run-ios --scheme template --mode Release",
    "ios:archive:template:release": "xcodebuild -workspace ios/template.xcworkspace -scheme template -configuration Release -sdk iphoneos archive -archivePath ios/build/template.xcarchive",
    "ios:run:templateQA:debug": "npx react-native run-ios --scheme templateQA --mode Debug",
    "ios:run:templateQA:release": "npx react-native run-ios --scheme templateQA --mode Release",
    "ios:archive:templateQA:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateQA -configuration Release -sdk iphoneos archive -archivePath ios/build/templateQA.xcarchive",
    "ios:run:templateStaging:debug": "npx react-native run-ios --scheme templateStaging --mode Debug",
    "ios:run:templateStaging:release": "npx react-native run-ios --scheme templateStaging --mode Release",
    "ios:archive:templateStaging:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateStaging -configuration Release -sdk iphoneos archive -archivePath ios/build/templateStaging.xcarchive",
    "ios:run:templateUAT:debug": "npx react-native run-ios --scheme templateUAT --mode Debug",
    "ios:run:templateUAT:release": "npx react-native run-ios --scheme templateUAT --mode Release",
    "ios:archive:templateUAT:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateUAT -configuration Release -sdk iphoneos archive -archivePath ios/build/templateUAT.xcarchive",
    "ios:run:templateDevelopment:debug": "npx react-native run-ios --scheme templateDevelopment --mode Debug",
    "ios:run:templateDevelopment:release": "npx react-native run-ios --scheme templateDevelopment --mode Release",
    "ios:archive:templateDevelopment:release": "xcodebuild -workspace ios/template.xcworkspace -scheme templateDevelopment -configuration Release -sdk iphoneos archive -archivePath ios/build/templateDevelopment.xcarchive",
    "test:coverage": "jest --coverage --watchAll=false"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@react-native-firebase/analytics": "^23.2.0",
    "@react-native-firebase/app": "^23.2.0",
    "@react-native-firebase/crashlytics": "^23.2.0",
    "@react-native-firebase/messaging": "^23.5.0",
    "@react-native/new-app-screen": "^0.81.0",
    "@react-navigation/bottom-tabs": "^7.4.6",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/native-stack": "^7.3.25",
    "@reduxjs/toolkit": "^2.8.2",
    "@shopify/flash-list": "^2.0.3",
    "axios": "^1.11.0",
    "bcryptjs": "^3.0.3",
    "i18next": "^25.4.2",
    "newrelic-react-native-agent": "^1.5.9",
    "react": "19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-i18next": "^15.7.3",
    "react-native": "0.81.0",
    "react-native-bootsplash": "^6.3.10",
    "react-native-config": "1.5.6",
    "react-native-device-info": "^14.1.1",
    "react-native-gesture-handler": "^2.29.1",
    "react-native-get-random-values": "^1.11.0",
    "react-native-keychain": "^10.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-mmkv": "4.0.0-beta.6",
    "react-native-nitro-modules": "^0.29.1",
    "react-native-reanimated": "^4.1.3",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.15.4",
    "react-native-sqlite-storage": "^6.0.1",
    "react-native-svg": "^15.12.1",
    "react-native-toast-message": "^2.3.3",
    "react-native-worklets": "^0.6.1",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1",
    "uuid": "^11.1.0",
    "yup": "^1.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.17.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.0",
    "@react-native/eslint-config": "0.81.0",
    "@react-native/metro-config": "0.81.0",
    "@react-native/typescript-config": "0.81.0",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.1.0",
    "@types/react-native-sqlite-storage": "^6.0.5",
    "@types/react-test-renderer": "^19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.27.0",
    "@typescript-eslint/parser": "^8.27.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "cross-env": "^7.0.3",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-testing-library": "^7.1.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "jest": "^29.6.3",
    "lint-staged": "^15.2.11",
    "plist": "^3.1.0",
    "prettier": "2.8.8",
    "react-native-svg-transformer": "^1.3.0",
    "react-test-renderer": "19.0.0",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.18.2"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
