    "react-i18next": "^15.5.2",
    "react-native": "0.79.3",
    "react-native-bootsplash": "^6.3.8",
    "react-native-config": "^1.5.5",
    "react-native-mmkv": "^3.2.0",
    "react-native-obfuscating-transformer": "^1.0.0",
